<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 允许测试项目访问 internal 共享 helper（如 BatchLoopHelper），以便对抽出的批循环逻辑做单元测试。 -->
    <InternalsVisibleTo Include="FlowEngine.Runtime.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\FlowEngine.Core\FlowEngine.Core.csproj" />
    <!-- 编译期合规守卫：禁止 NodeBase 派生节点引用服务定位器/索取式 API（见 FE0001）。 -->
    <ProjectReference Include="..\..\backend\FlowEngine.Analyzers\FlowEngine.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.11.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="MiniExcel" Version="1.45.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
  </ItemGroup>

</Project>
