{
  "name": "Flow Engine AI Agent CLI Skill",
  "version": "0.2.0",
  "description": "Flow Engine AI Agent CLI Skill，包含认证指南、命令参考、DSL 规范与常见错误排查。",
  "defaultServerUrl": "http://localhost:8001",
  "defaultAdmin": {
    "email": "admin@flowengine.local",
    "password": "<通过 FLOWENGINE_ADMIN_PASSWORD 或 Setup:AdminPassword 设置>",
    "note": "管理员密码需在服务首次启动前通过环境变量 FLOWENGINE_ADMIN_PASSWORD 或配置 Setup:AdminPassword 设置（至少 12 位，含大小写、数字及特殊字符）。首次登录后请创建 API Key 用于 AI 调用。"
  },
  "authGuide": {
    "recommended": "API Key（长期有效，无需刷新）",
    "loginWithApiKey": "flowengine login --url <server-url> --api-key <key> --json",
    "loginWithPassword": "flowengine login --url <server-url> --email <email> --password <password> --json",
    "createApiKey": "flowengine api-keys create --name \"ai-agent\" --json"
  },
  "cliCommands": [
    { "command": "login [--url <url>] [--email <email>] [--password <password>] [--api-key <key>]", "description": "登录并保存认证信息" },
    { "command": "logout", "description": "登出当前会话" },
    { "command": "me", "description": "获取当前用户信息" },
    { "command": "profile", "description": "显示当前 profile 认证信息" },
    { "command": "api-keys create --name <name> [--expires-at <date>]", "description": "创建 API Key" },
    { "command": "api-keys list", "description": "列出 API Key" },
    { "command": "api-keys revoke <id> --confirm", "description": "吊销 API Key" },
    { "command": "config get", "description": "获取当前配置" },
    { "command": "config set <key> <value>", "description": "设置配置项" },
    { "command": "config use-profile <name>", "description": "切换默认 profile" },
    { "command": "node-types list [--category <category>]", "description": "列出节点类型" },
    { "command": "node-types get <typeName>", "description": "查看单个节点类型详情（含完整参数和端口定义）" },
    { "command": "project list", "description": "列出项目" },
    { "command": "project get <id>", "description": "查看项目详情" },
    { "command": "credential list [--project-id <id>]", "description": "列出凭据" },
    { "command": "credential create --name <name> --type <type> --fields <json>", "description": "创建凭据" },
    { "command": "credential ensure --name <name> --type <type> --fields <json>", "description": "幂等创建/更新凭据" },
    { "command": "workflow create --file <file> [--name <name>] [--project-id <id>] [--dry-run]", "description": "创建工作流" },
    { "command": "workflow list [--project-id <id>]", "description": "列出工作流" },
    { "command": "workflow get <id> [--version <N>]", "description": "查看工作流详情" },
    { "command": "workflow update <id> [--file <file>] [--name <name>]", "description": "更新工作流" },
    { "command": "workflow export <id> [--output <file>]", "description": "导出工作流" },
    { "command": "workflow import <file> [--project-id <id>]", "description": "导入工作流" },
    { "command": "execute <workflow-id> [--wait] [--timeout <seconds>] [--input <json>]", "description": "执行工作流" },
    { "command": "execution get <id>", "description": "查看执行详情" },
    { "command": "execution list --workflow <id>", "description": "列出执行记录" },
    { "command": "execution cancel <id>", "description": "取消执行" },
    { "command": "test --file <file> [--expect <file>] [--credentials <json>]", "description": "Dry-Run 测试工作流" },
    { "command": "trigger list [--workflow <id>]", "description": "列出触发器" },
    { "command": "trigger create --workflow <id> --type <type> [--name <name>]", "description": "创建触发器" },
    { "command": "guide [--output <file>]", "description": "生成 DSL 编写指南（含节点类型清单）" }
  ],
  "dslSchema": {
    "fieldNaming": "camelCase",
    "topLevel": {
      "name": "string (required)",
      "projectId": "string (optional)",
      "nodes": "NodeDefinition[] (required)",
      "connections": "ConnectionDefinition[] (required)",
      "styleSettings": { "layoutDirection": "'vertical' | 'horizontal'" }
    },
    "node": {
      "id": "string (required)",
      "typeName": "string (required) — use node-types list to get available types",
      "name": "string (required)",
      "parameters": "Record<string, unknown> (required)",
      "ports": "PortInstance[] (required)",
      "positionX": "number",
      "positionY": "number",
      "isEntry": "boolean",
      "errorStrategy": "'Terminate' | 'Continue' | 'Retry'",
      "timeout": "string (ISO 8601 duration)"
    },
    "port": {
      "name": "string (must match node type port definition)",
      "direction": "'Input' | 'Output' (string enum, PascalCase, NOT number)",
      "type": "'Main' | 'AgentTool' | 'LLM' | 'Memory' (string enum)"
    },
    "connection": {
      "id": "string (required)",
      "sourceNodeId": "string (required)",
      "sourcePortName": "string (must be Output port)",
      "targetNodeId": "string (required)",
      "targetPortName": "string (must be Input port)",
      "condition": "string (optional)"
    }
  },
  "commonNodePorts": {
    "manualTrigger": { "outputs": ["Output (Main)"] },
    "set": { "inputs": ["Input (Main)"], "outputs": ["Output (Main)"] },
    "script": { "inputs": ["Input (Main)"], "outputs": ["Output (Main)"] },
    "httpRequest": { "inputs": ["Input (Main)"], "outputs": ["Output (Main)"] },
    "if": { "inputs": ["Input (Main)"], "outputs": ["True (Main)", "False (Main)"] },
    "llm": { "outputs": ["Output (Main)"] },
    "agent": { "inputs": ["Input (Main)"], "outputs": ["Output (Main)", "Input (AgentTool)", "Input (AgentTool)"] },
    "loop": { "inputs": ["Input (Main)"], "outputs": ["Output (Main)", "Done (Main)"] },
    "merge": { "inputs": ["Input (Main)", "Input (Main)"], "outputs": ["Output (Main)"] }
  },
  "agentIdeWorkflow": {
    "description": "Flow Engine 不再通过后端 LLM 生成 DSL。Agent IDE 应直接基于本 Skill 与 CLI 输出构造合法 DSL，再经 CLI 校验并提交。",
    "steps": [
      { "order": 1, "action": "获取节点类型定义", "commands": ["node-types list --json", "node-types get <typeName> --json"] },
      { "order": 2, "action": "获取 DSL 编写指南", "commands": ["guide --json"] },
      { "order": 3, "action": "由 Agent IDE 直接生成 DSL JSON", "commands": [] },
      { "order": 4, "action": "Dry-Run 校验", "commands": ["workflow create --file workflow.json --dry-run --json", "test --file workflow.json --json"] },
      { "order": 5, "action": "提交工作流", "commands": ["workflow create --file workflow.json --json"] }
    ],
    "note": "CLI 不再提供 workflow generate 命令，请勿调用后端 /api/v1/workflows/generate。"
  },
  "commonErrors": [
    { "error": "Port direction enum conversion failed", "cause": "direction used Out/In or number", "fix": "Use 'Input' / 'Output' string values" },
    { "error": "Port type enum conversion failed", "cause": "type used Flow", "fix": "Use 'Main' / 'AgentTool' / 'LLM' / 'Memory'" },
    { "error": "Workflow validation failed", "cause": "Missing ports array on nodes", "fix": "Every node must include ports array" },
    { "error": "CredentialNotFound", "cause": "Referenced credential does not exist", "fix": "Create credential first with credential create" },
    { "error": "DisconnectedGraph", "cause": "Isolated nodes or missing entry", "fix": "Set isEntry=true on trigger node, connect all nodes" }
  ]
}
