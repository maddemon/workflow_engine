<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlowEngine.Core.Tests" />
    <InternalsVisibleTo Include="FlowEngine.Runtime" />
    <InternalsVisibleTo Include="FlowEngine.Runtime.Tests" />
    <InternalsVisibleTo Include="FlowEngine.Application" />
  </ItemGroup>

  <ItemGroup>
    <!-- 编译期合规守卫：禁止 NodeBase 派生节点引用服务定位器/索取式 API（见 FE0001）。 -->
    <ProjectReference Include="..\FlowEngine.Analyzers\FlowEngine.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <!-- A1：脚本引擎与 HTTP 辅助类型下沉 Core，使插件仅依赖 Core 即可（不再引用 Runtime）。 -->
    <PackageReference Include="Jint" Version="4.11.0" />
    <!-- 2.1：以 MediatR 替代手搓 InMemoryEventBus 作为领域事件分发机制。 -->
    <PackageReference Include="MediatR" Version="12.4.1" />
  </ItemGroup>

</Project>
