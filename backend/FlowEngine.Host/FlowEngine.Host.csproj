<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowEngine.Application\FlowEngine.Application.csproj" />
    <ProjectReference Include="..\FlowEngine.Infrastructure\FlowEngine.Infrastructure.csproj" />
    <ProjectReference Include="..\FlowEngine.Resources\FlowEngine.Resources.csproj" />
    <ProjectReference Include="..\FlowEngine.Runtime\FlowEngine.Runtime.csproj" />
    <ProjectReference Include="..\FlowEngine.Migrations.Sqlite\FlowEngine.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\FlowEngine.Migrations.Postgres\FlowEngine.Migrations.Postgres.csproj" />
  </ItemGroup>

  <Target Name="BuildPlugins" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\..\plugins\FlowEngine.Plugins.Standard\FlowEngine.Plugins.Standard.csproj" Targets="Build" />
    <MSBuild Projects="..\..\plugins\FlowEngine.Plugins.Storage\FlowEngine.Plugins.Storage.csproj" Targets="Build" />
    <!-- 仅将插件私有依赖同步到插件扫描目录（../../plugins）。
         宿主默认加载上下文已提供的共享程序集（FlowEngine.* / Jint / OpenAI / Microsoft.Extensions.* /
         System.ClientModel / IdentityModel / Newtonsoft.Json 等）一律排除，避免 plugins/ 中的旧版本与宿主版本
         冲突导致 TypeLoadException（如 System.ClientModel 1.8.0.0 缺少 ClientSettings）。
         PluginLoadContext.Load 会优先复用默认上下文中已加载的同名程序集，因此排除后插件仍能正确解析这些依赖。 -->
    <ItemGroup>
      <PluginOutputFiles Include="..\..\plugins\FlowEngine.Plugins.Standard\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <PluginOutputFiles Include="..\..\plugins\FlowEngine.Plugins.Standard\bin\$(Configuration)\$(TargetFramework)\*.pdb" />
      <PluginOutputFiles Include="..\..\plugins\FlowEngine.Plugins.Storage\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <PluginOutputFiles Include="..\..\plugins\FlowEngine.Plugins.Storage\bin\$(Configuration)\$(TargetFramework)\*.pdb" />
      <PluginOutputFiles Remove="@(PluginOutputFiles)"
        Condition="Exists('$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="..\..\plugins" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPluginsOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <PluginAssemblies Include="..\..\plugins\FlowEngine.Plugins.Standard\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <PluginAssemblies Include="..\..\plugins\FlowEngine.Plugins.Storage\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <PluginAssemblies Remove="@(PluginAssemblies)"
        Condition="Exists('$(PublishDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="@(PluginAssemblies)" DestinationFolder="$(PublishDir)plugins\" SkipUnchangedFiles="true" />
  </Target>

<ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- 宿主按 Database:Provider 配置 DbContext，需直接引用所支持 provider 的 EF 包
         （不再依赖迁移程序集透传，避免迁移程序集被裁剪后宿主编译失败）。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="DM.Microsoft.EntityFrameworkCore" Version="9.0.0.43760" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0-preview.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.12.0" />
    <PackageReference Include="Quartz" Version="3.18.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.18.1" />
  </ItemGroup>

</Project>
