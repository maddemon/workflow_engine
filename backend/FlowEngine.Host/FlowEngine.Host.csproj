<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowEngine.Application\FlowEngine.Application.csproj" />
    <ProjectReference Include="..\FlowEngine.Infrastructure\FlowEngine.Infrastructure.csproj" />
    <ProjectReference Include="..\FlowEngine.Runtime\FlowEngine.Runtime.csproj" />
    <ProjectReference Include="..\FlowEngine.Migrations\FlowEngine.Migrations.csproj" />
  </ItemGroup>

  <Target Name="BuildPlugins" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\..\plugins\FlowEngine.Plugins.Standard\FlowEngine.Plugins.Standard.csproj" Targets="Build" />
    <!-- 仅将插件私有依赖同步到插件扫描目录（../../plugins）。
         宿主默认加载上下文已提供的共享程序集（FlowEngine.* / Jint / OpenAI / Microsoft.Extensions.* /
         System.ClientModel / IdentityModel / Newtonsoft.Json 等）一律排除，避免 plugins/ 中的旧版本与宿主版本
         冲突导致 TypeLoadException（如 System.ClientModel 1.8.0.0 缺少 ClientSettings）。
         PluginLoadContext.Load 会优先复用默认上下文中已加载的同名程序集，因此排除后插件仍能正确解析这些依赖。 -->
    <ItemGroup>
      <PluginOutputFiles Include="..\..\plugins\FlowEngine.Plugins.Standard\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <PluginOutputFiles Include="..\..\plugins\FlowEngine.Plugins.Standard\bin\$(Configuration)\$(TargetFramework)\*.pdb" />
      <PluginOutputFiles Remove="@(PluginOutputFiles)"
        Condition="Exists('$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="..\..\plugins" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPluginsOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <PluginAssemblies Include="..\..\plugins\FlowEngine.Plugins.Standard\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <PluginAssemblies Remove="@(PluginAssemblies)"
        Condition="Exists('$(PublishDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="@(PluginAssemblies)" DestinationFolder="$(PublishDir)plugins\" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Quartz" Version="3.18.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.18.1" />
  </ItemGroup>

</Project>
