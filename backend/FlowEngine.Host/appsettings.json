{
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/flowengine.db;Mode=ReadWriteCreate;Cache=Shared"
  },
  "Plugins": {
    "Path": "../../plugins"
  },
  "Expression": {
    "EnvironmentWhitelist": []
  },
  "Storage": {
    "Type": "LocalFileSystem",
    "Path": "./storage"
  },
  "FileStorage": {
    "BasePath": "./storage/files",
    "MaxFileSizeBytes": 52428800,
    "AllowedContentTypes": []
  },
  "Audit": {
    "LogPath": "./storage/audit"
  },
  "ExecutionCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "RetentionDays": 30,
    "MaxRecordsToKeep": 10000,
    "BatchSize": 500,
    "BatchDelayMs": 100
  },
  "EngineDefaults": {
    "DefaultTimeoutSeconds": null,
    "DefaultMaxRetries": 0,
    "DefaultBaseDelaySeconds": 1,
    "DefaultMaxDelaySeconds": 60
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "FlowEngine",
    "Audience": "FlowEngine",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4000"]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "Enabled": true
    },
    "Register": {
      "PermitLimit": 3,
      "WindowSeconds": 60,
      "Enabled": true
    },
    "Api": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "Enabled": true
    },
    "WhitelistedPaths": ["/health", "/health/ready"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
